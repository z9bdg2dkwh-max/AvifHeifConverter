<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AvifHeifConverter.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvifHeifConverter.Gui">

    <!-- ★ 根容器必须显式给背景色。
         WinUI 3 免打包（WindowsPackageType=None）应用若根容器不设 Background，
         窗口会呈现**纯黑**，而不是 Windows 标准的主题灰 —— 观感很怪异。
         ApplicationPageBackgroundThemeBrush 是 WinUI 的页面标准底色，
         浅色下为 #F3F3F3、深色下为 #202020，与「设置」等系统应用一致。 -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 自定义标题栏（可拖动，含主题按钮）-->
            <RowDefinition Height="*" />      <!-- 内容区 -->
        </Grid.RowDefinitions>

        <!-- ========== 自定义标题栏 ==========
             配合 Window.ExtendsContentIntoTitleBar = true：内容延伸到标题栏区域后，
             系统标题栏那条「浅色横条」消失，最小化/最大化/关闭三个按钮直接画在
             本软件自己的底色上，整体观感统一。
             布局要点：应用标题靠左；右侧必须为系统按钮留出空间 ——
             宽度取自 AppWindow.TitleBar.RightInset，在代码里设置 ThemeButton 的右边距。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xEB9F;" FontSize="14" Opacity="0.9" />
                <TextBlock Text="AVIF → HEIC 转换器" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="ThemeButton" Click="ThemeButton_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="7" Margin="0,0,8,0"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE793;" FontSize="14" />
            </Button>
        </Grid>

        <!-- ========== 内容区 ========== -->
        <Grid Grid.Row="1" Padding="16,2,16,14" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 说明 + 引擎状态 -->
                <RowDefinition Height="*" />      <!-- 主体 -->
                <RowDefinition Height="Auto" />   <!-- 进度 -->
                <RowDefinition Height="180" />    <!-- 日志 -->
            </Grid.RowDefinitions>

            <!-- 说明与引擎状态 -->
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Style="{StaticResource HintText}"
                           Text="把带 HDR Gain Map 的 AVIF 转成 iPhone 可正常显示 HDR 的 HEIC；保留 Exif / XMP / 色彩信息，大图自动分块。" />
                <InfoBar x:Name="EngineBar" IsOpen="False" IsClosable="False" />
            </StackPanel>

            <!-- 主体 -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- 文件队列 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}"
                                   Text="待转换文件（可直接把文件拖进来）" />

                        <ListView x:Name="FileList" Grid.Row="1"
                                  AllowDrop="True" DragOver="FileList_DragOver" Drop="FileList_Drop"
                                  SelectionMode="Extended" BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileItem">
                                    <Grid ColumnSpacing="10" Padding="0,4" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                                   Opacity="0.5" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}"
                                                   Opacity="0.65" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddButton" Click="AddButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="添加文件" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveButton" Click="RemoveButton_Click" Content="移除选中" />
                            <Button x:Name="ClearButton" Click="ClearButton_Click" Content="清空" />
                            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                                       Style="{StaticResource HintText}" Text="0 个文件" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 设置 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="转换设置" Margin="0" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="输出目录" FontSize="12" Opacity="0.8" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutDirBox" Grid.Column="0" PlaceholderText="默认与源文件同目录" />
                                    <Button Grid.Column="1" Content="浏览…" Click="PickOutDir_Click" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="失败文件归集目录" FontSize="12" Opacity="0.8" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FailDirBox" Grid.Column="0" PlaceholderText="留空 = 不归集；转换失败的文件会复制到此目录并登记清单" />
                                    <Button Grid.Column="1" Content="浏览…" Click="PickFailDir_Click" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock Text="基底质量" FontSize="12" Opacity="0.8"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Spacing="6" VerticalAlignment="Center">
                                        <HyperlinkButton x:Name="QualityReset" Content="建议 92"
                                                         FontSize="11" Padding="4,0"
                                                         Click="ResetQuality_Click"
                                                         ToolTipService.ToolTip="点击恢复到建议值 92" />
                                        <TextBlock x:Name="QualityText" Text="92" FontSize="12"
                                                   MinWidth="30" TextAlignment="Right" Opacity="0.8" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="色度采样" VerticalAlignment="Center" Width="64" />
                                    <ComboBox x:Name="ChromaBox" Width="180"
                                              ToolTipService.ToolTip="源 AVIF 普遍是 4:4:4。保留 4:4:4 放大看色度边缘更干净（实测 iPhone 显示正常，体积接近）；4:2:0 体积最小但彩色细节会糊。">
                                        <ComboBoxItem Content="保留 4:4:4（推荐）" IsSelected="True" />
                                        <ComboBoxItem Content="4:2:2" />
                                        <ComboBoxItem Content="4:2:0（体积最小）" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="画质预设" VerticalAlignment="Center" Width="64" />
                                    <ComboBox x:Name="QualityPresetBox" Width="180"
                                              SelectionChanged="QualityPresetBox_Changed"
                                              ToolTipService.ToolTip="一键切换画质与体积的取舍；选「自定义」后可手动拖下方滑块">
                                        <ComboBoxItem Content="均衡（推荐）" IsSelected="True" />
                                        <ComboBoxItem Content="高画质（体积大）" />
                                        <ComboBoxItem Content="小体积（省空间）" />
                                        <ComboBoxItem Content="自定义" />
                                    </ComboBox>
                                </StackPanel>
                                <Slider x:Name="QualitySlider" Minimum="60" Maximum="100" Value="92"
                                        StepFrequency="1" ValueChanged="QualitySlider_ValueChanged" />
                                <TextBlock Style="{StaticResource HintText}" Text="影响普通画面细节；越高文件越大。" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock Text="增益图质量" FontSize="12" Opacity="0.8"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Spacing="6" VerticalAlignment="Center">
                                        <HyperlinkButton x:Name="GmQualityReset" Content="建议 90"
                                                         FontSize="11" Padding="4,0"
                                                         Click="ResetGmQuality_Click"
                                                         ToolTipService.ToolTip="点击恢复到建议值 90" />
                                        <TextBlock x:Name="GmQualityText" Text="90" FontSize="12"
                                                   MinWidth="30" TextAlignment="Right" Opacity="0.8" />
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="GmQualitySlider" Minimum="60" Maximum="100" Value="90"
                                        StepFrequency="1" ValueChanged="GmQualitySlider_ValueChanged" />
                                <TextBlock Style="{StaticResource HintText}" Text="影响 HDR 高光的过渡平滑度。" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock Text="增益上限（HDR 强度）" FontSize="12" Opacity="0.8"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Spacing="6" VerticalAlignment="Center">
                                        <HyperlinkButton x:Name="GainCapReset" Content="建议 2.2"
                                                         FontSize="11" Padding="4,0"
                                                         Click="ResetGainCap_Click"
                                                         ToolTipService.ToolTip="点击恢复到建议值 2.2" />
                                        <TextBlock x:Name="GainCapText" Text="2.2" FontSize="12"
                                                   MinWidth="30" TextAlignment="Right" Opacity="0.8" />
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="GainCapSlider" Minimum="1.0" Maximum="4.0" Value="2.2"
                                        StepFrequency="0.1" ValueChanged="GainCapSlider_ValueChanged" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="对数域上限。苹果原生文件约 2.07；数值越大高光越亮，过大易过曝。" />
                            </StackPanel>

                            <CheckBox x:Name="AutoCapCheck" Content="按内容自动匹配 HDR 强度（推荐）"
                                      IsChecked="True" Checked="AutoCapCheck_Changed"
                                      Unchecked="AutoCapCheck_Changed"
                                      ToolTipService.ToolTip="实测该图需要多少增益再决定上限，既不削顶也不浪费精度。取消勾选后使用下方手动值" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="固定的上限要么削顶、要么浪费精度。实测苹果样张在固定 2.2 下有 1.34% 的高光被截断；落日只需 1.53，固定 2.2 纯属浪费。" />
                            <CheckBox x:Name="MultichannelCheck"
                                      Content="使用三通道增益图（推荐）" IsChecked="True"
                                      ToolTipService.ToolTip="逐通道记录增益。关闭则改用单通道（体积略小），但饱和度高的画面（落日、霓虹）会丢失 HDR 效果" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="三通道是苹果与索尼原生文件的做法。单通道按亮度算增益，遇到「红色饱和但整体亮度不高」的画面（如落日）增益会几乎全为 0 —— 等于没有 HDR。" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="同时转换" VerticalAlignment="Center" Width="64" />
                                <ComboBox x:Name="ParallelCountBox" Width="180"
                                          ToolTipService.ToolTip="自动模式：每张开工前探测其内存需求，放得下才启动，并始终给系统留出 10% 内存 —— 既吃满余量又不会卡死。也可固定为 1~3 张。">
                                    <ComboBoxItem Content="自动（按内存余量，推荐）" IsSelected="True" />
                                    <ComboBoxItem Content="1 张（固定，内存最省）" />
                                    <ComboBoxItem Content="2 张（固定）" />
                                    <ComboBoxItem Content="3 张（固定）" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="OverwriteCheck" Content="覆盖同名文件"
                                      IsChecked="False"
                                      ToolTipService.ToolTip="不勾选时（默认）：输出目录已有同名 .heic 就跳过并提示，绝不覆盖 —— 防止误删已有成果。勾选后才会覆盖。" />
                            <CheckBox x:Name="OpenFolderCheck" Content="转换完成后打开输出文件夹" IsChecked="False" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 进度 -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}"
                        Click="StartButton_Click" MinWidth="110">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock x:Name="StartButtonText" Text="开始转换" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <ProgressBar x:Name="Progress" Value="0" Maximum="1" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Text="就绪" />
                </StackPanel>

                <Button x:Name="CancelButton" Grid.Column="2" Content="停止"
                        Click="CancelButton_Click" IsEnabled="False" />
            </Grid>

            <!-- 日志 -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="10">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="转换日志" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <HyperlinkButton Content="复制全部" FontSize="11" Padding="4,0"
                                             Click="CopyLog_Click"
                                             ToolTipService.ToolTip="把日志复制到剪贴板，便于反馈问题" />
                            <HyperlinkButton Content="打开日志文件" FontSize="11" Padding="4,0"
                                             Click="OpenLogFile_Click"
                                             ToolTipService.ToolTip="日志同时写入文件，出错时可发给对方" />
                            <Button Padding="6,2" FontSize="11" Content="清空" Click="ClearLog_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
